# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=algo_trader
MYSQL_USER=trader
MYSQL_PASSWORD=your_secure_password

# Questrade API Configuration
# DO NOT commit actual tokens - use .env file (in .gitignore)
QUESTRADE_REFRESH_TOKEN=your_refresh_token_here
QUESTRADE_API_URL=https://api01.iq.questrade.com

# Interactive Brokers Configuration
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=your_account_id

# Risk Management Parameters
MAX_POSITION_RISK_PCT=2.0
MAX_PORTFOLIO_RISK_PCT=10.0
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_CONCURRENT_POSITIONS=5
MAX_POSITION_SIZE_PCT=10.0
MAX_TOTAL_DEPLOYED_PCT=30.0

# Strategy Parameters
STOP_LOSS_PCT=2.0
TAKE_PROFIT_MULTIPLIER=3.0
TRAILING_STOP_ATR_MULTIPLIER=2.0
TIME_BASED_EXIT_DAYS=10
MIN_INDICATOR_CONFLUENCE=3

# Technical Indicator Settings
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20
BOLLINGER_STD=2
ATR_PERIOD=14
ADX_PERIOD=14
ADX_THRESHOLD=25

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=logs/algo_trader.log
API_HOST=0.0.0.0
API_PORT=8000

# Alert Settings (optional)
ALERT_EMAIL=your_email@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_password
